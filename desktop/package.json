{
  "name": "textfold-desktop",
  "private": true,
  "version": "0.10.7",
  "description": "TextFold as an app: the local server and the reader in one window",
  "license": "Apache-2.0",
  "author": "Xia Chen",
  "repository": "github:chenxiachan/textfold",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "payload": "node scripts/prepare-payload.mjs",
    "dist:win": "node scripts/prepare-payload.mjs win32 x64 && electron-builder --win nsis --x64 --publish never"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.chenxiachan.textfold",
    "productName": "TextFold",
    "icon": "build/icon.png",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "preload.js",
      "splash.html",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "payload",
        "to": "payload"
      }
    ],
    "npmRebuild": false,
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "${productName}-win-${arch}-setup.${ext}",
      "shortcutName": "TextFold",
      "uninstallDisplayName": "TextFold"
    },
    "publish": {
      "provider": "github",
      "owner": "chenxiachan",
      "repo": "textfold"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
