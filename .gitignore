papers/
# exported pages (they hold the papers' text and figures)
out/
# the sidebar's state when the server runs from the source checkout (store.DATA is the clone there)
/library.json
# a sample PDF dropped in tests/ for a manual check; the suite makes its own
tests/*.pdf
__pycache__/
*.pyc
*.tmp
.DS_Store
.env
# experiments and their tools, and the research data made from them: kept on this computer
tools/modelbench/
tools/zoombench_ext.py
research/
launch/
# the app: its build tools, the runtime it ships, and the packages it makes
desktop/node_modules/
desktop/payload/
desktop/out/
# the MyGo shell and the shared Python payload it packages
desktop-mygo/.mygo/
desktop-mygo/build/
desktop-mygo/resources/payload/
# the maintainer's working log, kept on this computer
STATUS.md
WINDOWS-ONLY.md

# a pip build from the clone (desktop/build/ is the app's icon)
/build/
/dist/
*.egg-info/
# a virtual environment made inside the clone (CONTRIBUTING installs into the system's Python instead)
.venv/
# worktrees the optimize workflow makes here: each is a whole checkout of this repo, not files of it
.claude/worktrees/
# the per-computer launch configuration for Claude Code
/.claude/launch.json
# the detailed log the optimize workflow keeps on this computer; the committed record is docs/changes/
notes/
# the website's build (site/build.py): the pages it writes, and the preview with its checks
site/dist/
site/preview.html
site/_*
# a reference checkout of the MyGo framework, kept on this computer
/mygo/
